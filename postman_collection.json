{
  "info": {
    "name": "Healthcare API - Auth Service",
    "description": "Collection for testing Auth Service and API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth Service (Direct - Port 8081)",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_smith\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login with existing user credentials and get JWT token"
          },
          "response": []
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"email\": \"john@hospital.com\",\n  \"password\": \"SecurePass456!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"role\": \"DOCTOR\"\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user (PATIENT or DOCTOR role)"
          },
          "response": []
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text",
                "description": "Paste the token from Login response here"
              }
            ],
            "url": {
              "raw": "http://localhost:8081/api/auth/validate",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "auth",
                "validate"
              ]
            },
            "description": "Validate JWT token - requires Bearer token in Authorization header"
          },
          "response": []
        },
        {
          "name": "Get User by Username",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/auth/user/alice_smith",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8081",
              "path": [
                "api",
                "auth",
                "user",
                "alice_smith"
              ]
            },
            "description": "Get user details by username (public endpoint)"
          },
          "response": []
        }
      ],
      "description": "Direct endpoints on Auth Service (Port 8081)"
    },
    {
      "name": "API Gateway (Port 8080)",
      "item": [
        {
          "name": "Login via Gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_smith\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login through API Gateway (Port 8080) - forwards to Auth Service (Port 8081)"
          },
          "response": []
        },
        {
          "name": "Register via Gateway",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sarah_johnson\",\n  \"email\": \"sarah@hospital.com\",\n  \"password\": \"SecurePass789!\",\n  \"firstName\": \"Sarah\",\n  \"lastName\": \"Johnson\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register through API Gateway (Port 8080) - forwards to Auth Service (Port 8081)"
          },
          "response": []
        },
        {
          "name": "Validate Token via Gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text",
                "description": "Paste the token from Login response"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/auth/validate",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "validate"
              ]
            },
            "description": "Validate token through API Gateway (Port 8080)"
          },
          "response": []
        },
        {
          "name": "Get User via Gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/auth/user/alice_smith",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "auth",
                "user",
                "alice_smith"
              ]
            },
            "description": "Get user through API Gateway (Port 8080) - forwards to Auth Service (Port 8081)"
          },
          "response": []
        }
      ],
      "description": "Requests routed through API Gateway (Port 8080) to Auth Service (Port 8081)"
    },
    {
      "name": "Patient Service (Port 8080)",
      "item": [
        {
          "name": "Create Patient Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text",
                "description": "JWT token - get from Login endpoint"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"FEMALE\",\n  \"phoneNumber\": \"+1-555-0101\",\n  \"address\": \"123 Main Street, Springfield\",\n  \"emergencyContact\": \"Jane Smith\",\n  \"medicalHistory\": \"No known allergies\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/patients",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "patients"
              ]
            },
            "description": "Creates a patient profile for the authenticated user. Requires valid JWT token."
          },
          "response": []
        },
        {
          "name": "Get Current Patient Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text",
                "description": "JWT token - get from Login endpoint"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/patients/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "patients",
                "me"
              ]
            },
            "description": "Returns the current authenticated patient's profile. Requires valid JWT token."
          },
          "response": []
        },
        {
          "name": "Update Current Patient Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "type": "text",
                "description": "JWT token - get from Login endpoint"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"gender\": \"FEMALE\",\n  \"phoneNumber\": \"+1-555-0102\",\n  \"address\": \"456 Oak Avenue, Springfield\",\n  \"emergencyContact\": \"John Smith\",\n  \"medicalHistory\": \"Hypertension, on medication\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/patients/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "patients",
                "me"
              ]
            },
            "description": "Updates the current authenticated patient's profile. Requires valid JWT token."
          },
          "response": []
        }
      ],
      "description": "Patient Service endpoints for managing patient profiles"
    }
  ],
  "variable": [
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "JWT token from login response - copy and paste here or use Postman's set variable feature"
    }
  ]
}

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle rectangle\nskinparam backgroundColor #FFFFFF\nskinparam packageBackgroundColor #F9F9F9\n\nactor \&quot;User/Frontend\&quot; as User\n\npackage \&quot;Orchestration &amp; Routing\&quot; {\n    component \&quot;api-gateway:8080\&quot; as Gateway #f96\n}\n\npackage \&quot;Core Microservices\&quot; {\n    component \&quot;auth-service:8081\&quot; as Auth #bbf\n    component \&quot;patient-service:8082\&quot; as Patient\n    component \&quot;doctor-service:8083\&quot; as Doctor\n    component \&quot;appointment-service:8085\&quot; as Appointment\n    component \&quot;telemedicine-service:8084\&quot; as Telemed\n    component \&quot;ai-symptom-checker:8087\&quot; as AI #dfd\n    component \&quot;payment-service:8086\&quot; as Payment\n}\n\ncomponent \&quot;notification-service:8088\&quot; as Notification #ffd\n\npackage \&quot;Databases\&quot; {\n    database \&quot;auth-postgres\&quot; as AuthDB\n    database \&quot;patient-postgres\&quot; as PatientDB\n    database \&quot;doctor-postgres\&quot; as DoctorDB\n    database \&quot;appointment-postgres\&quot; as AppointDB\n    database \&quot;payment-postgres\&quot; as PayDB\n    database \&quot;notification-postgres\&quot; as NotifDB\n}\n\npackage \&quot;External Integrations\&quot; {\n    cloud \&quot;Gemini AI API\&quot; as Gemini\n    cloud \&quot;AWS S3 - Reports\&quot; as S3\n    cloud \&quot;Stripe API\&quot; as Stripe\n    cloud \&quot;Agora SDK\&quot; as Agora\n    cloud \&quot;SMTP Mail Server\&quot; as SMTP\n}\n\nUser --&gt; Gateway\n\nGateway --&gt; Auth\nGateway --&gt; Patient\nGateway --&gt; Doctor\nGateway --&gt; Appointment\nGateway --&gt; Telemed\nGateway --&gt; AI\nGateway --&gt; Payment\n\nPatient --&gt; Appointment : Query Appointments\nPatient --&gt; Doctor : Fetch Prescriptions\nTelemed --&gt; Appointment : Verify Appointment\nPayment --&gt; Notification : Trigger Alerts\nNotification --&gt; Patient : Fetch Patient Details\n\nAuth --&gt; AuthDB\nPatient --&gt; PatientDB\nDoctor --&gt; DoctorDB\nAppointment --&gt; AppointDB\nPayment --&gt; PayDB\nNotification --&gt; NotifDB\n\nAI -- Gemini\nPatient -- S3\nPayment -- Stripe\nTelemed -- Agora\nNotification -- SMTP\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="f64youRh0oOtQmGQaYtz-1">

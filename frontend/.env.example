# Optional: override doctor-service base URL.
# For local dev with Vite proxy, leave this unset.
# Example direct backend URL:
# VITE_DOCTOR_SERVICE_URL=http://localhost:8083

# Optional: override auth API base URL for doctor login/register.
# For local dev with Vite proxy (/api -> gateway), leave this unset.
# Example direct gateway URL:
# VITE_AUTH_SERVICE_URL=http://localhost:8080/api/auth

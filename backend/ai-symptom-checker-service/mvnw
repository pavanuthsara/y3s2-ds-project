set -e

PRG="$0"
while [ -h "$PRG" ] ; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`"/$link"
  fi
done

DIRNAME=`dirname "$PRG"`
SCRIPT_NAME=`basename "$PRG"`

# Make absolute path to script
SCRIPT_PATH="$DIRNAME/$SCRIPT_NAME"

# Resolve absolute path
SCRIPT_PATH=`cd "$DIRNAME" 2>/dev/null && pwd -P`"/$SCRIPT_NAME"

# Determine directory of maven distribution
MAVEN_WRAPPER_DISTS="${MAVEN_USER_HOME:-$HOME/.m2}/wrapper/dists"

# Extract and validate
PROPS_FILE="$DIRNAME/.mvn/wrapper/maven-wrapper.properties"

if [ ! -f "$PROPS_FILE" ]; then
  echo "Maven wrapper properties file not found: $PROPS_FILE"
  exit 1
fi

DIST_URL=$(grep "^distributionUrl=" "$PROPS_FILE" | cut -d= -f2-)
DIST_SHA256=$(grep "^distributionSha256Sum=" "$PROPS_FILE" | cut -d= -f2-)

exec "$DIRNAME/.mvn/wrapper/MavenWrapperDownloader.sh" "$MAVEN_WRAPPER_DISTS" "$DIST_URL" "$DIST_SHA256"

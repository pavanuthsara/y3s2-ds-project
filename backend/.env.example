# Copy this file to .env in the same folder and set real values.
# Never commit .env to git.

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
SYMPTOM_MOCK_ENABLED=true

AGORA_APP_ID=PASTE_YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=PASTE_YOUR_AGORA_APP_CERTIFICATE
AGORA_TOKEN_TTL_SECONDS=3600

# Notification Service: Gmail SMTP
# Use a Gmail App Password (not your regular password): https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your.gmail@gmail.com

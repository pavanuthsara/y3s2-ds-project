      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8088/api/notifications/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "notifications", "health"]
            },
            "description": "Check if Notification Service is running"
          },
          "response": []
        },
        {
          "name": "Send Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"patient@example.com\",\n  \"subject\": \"Test Notification\",\n  \"message\": \"This is a test notification message.\",\n  \"type\": \"GENERAL_NOTIFICATION\",\n  \"channel\": \"EMAIL\",\n  \"patientId\": \"patient-123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8088/api/notifications/send",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8088",
              "path": ["api", "notifications", "send"]
            },
            "description": "Send a custom notification"
          },
          "response": []
        },
